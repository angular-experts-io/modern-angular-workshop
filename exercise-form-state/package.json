{
  "name": "exercise-form-state",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm-run-all --parallel serve serve:api",
    "serve": "ng serve -o --no-hmr",
    "serve:api": "json-server --watch db.json --delay 750 --port 4300 --routes db-routes.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "ci": "npm run lint && npm run test && npm run build",
    "analyze": "ng build --stats-json --output-hashing none --named-chunks && esbuild-visualizer --template treemap --metadata dist/product-app/stats.json --filename dist/product-app/analyse/index.html && http-server -o -c-1 ./dist/product-app/analyse/",
    "analyze:sme": "ng build --source-map --output-hashing none --named-chunks && source-map-explorer dist/product-app/browser/*.js --html dist/product-app/sme/index.html && http-server -o -c-1 ./dist/product-app/sme/",
    "format:write": "prettier \"projects/**/*.{ts,scss,json,html,js}\" --write",
    "format:test": "prettier  \"projects/**/*.{ts,scss,json,html,js}\" --list-different"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.1.0-next.4",
    "@angular/common": "^21.1.0-rc.0",
    "@angular/compiler": "^21.1.0-rc.0",
    "@angular/core": "^21.1.0-rc.0",
    "@angular/forms": "^21.1.0-rc.0",
    "@angular/material": "^21.1.0-next.4",
    "@angular/platform-browser": "^21.1.0-rc.0",
    "@angular/router": "^21.1.0-rc.0",
    "chart.js": "~4.4.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "1.57.0",
    "@vitest/ui": "^4.0.16",
    "angular-eslint": "21.1.0",
    "autoprefixer": "^10.4.23",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.3.1",
    "http-server": "^14.1.1",
    "jsdom": "^27.1.0",
    "json-server": "^0.17.4",
    "npm-run-all": "^4.1.5",
    "playwright-ng-schematics": "^21.0.3",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.47.0",
    "vitest": "^4.0.8"
  },
  "prettier": {
    "printWidth": 90,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  }
}
